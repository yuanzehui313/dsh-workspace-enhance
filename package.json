{
  "name": "dsh-workspace-enhance",
  "description": "DeepSeek Harness workspace & session enhancement plugin: recycle bin, cross-workspace session drag, ungrouped sessions, multi-folder workspace roots, in-app directory picker, session merge, folder/file sections, multi-select picker, session files & drag-drop upload, file preview — shipped as an overlay patch-set with install scripts",
  "version": "1.0.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuanzehui313/dsh-workspace-enhance.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/cost-meter.mjs",
    "overlay/**/*",
    "scripts/apply-overlay.mjs",
    "scripts/*.ps1",
    "handover/**/*",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "node scripts/apply-overlay.mjs"
  },
  "license": "MIT",
  "keywords": [
    "deepseek",
    "dsh",
    "dsh-plugin",
    "workspace",
    "recycle-bin",
    "session"
  ]
}
